// Roots of f: R -> R. Bracketing methods keep a sign change and always
// converge: bisection (linear), Ridders (quadratic, Ridders 1979),
// Brent (Brent 1973, inverse quadratic interpolation with bisection
// safeguard), TOMS 748 (Alefeld, Potra and Shi 1995, inverse cubic
// interpolation and double-length secant steps; the fewest evaluations
// on smooth functions). Open methods start from a point and converge
// fast near a simple root but may diverge: Newton, Halley, secant.

use pkg::error::{OptimizeError, option};
use pkg::result::Status;
use autodiff::Dual;

const EPS: f64 = 2.220446049250313e-16;

/// A root of a scalar function.
///
/// ```nabi
/// let r = try optimize::brentq(|x: f64| -> f64 { x * x - 2.0 }, 0.0, 2.0);
/// assert(r.success() && (r.x - 2.0f64.sqrt()).abs() < 1e-12);
/// ```
#[derive(Clone, Copy, PartialEq, Debug)]
pub struct Root {
    /// The root.
    pub x: f64;
    /// `f(x)`.
    pub fx: f64;
    /// Iterations taken.
    pub iterations: usize;
    /// Evaluations of `f` (and of its derivatives, for the open
    /// methods).
    pub nfev: usize;
    /// `Converged`, `MaxIterations`, `NotFinite` or, for the open
    /// methods, `Stalled` (a zero derivative).
    pub status: Status;
}

impl Root {
    /// Whether the tolerance was met.
    ///
    /// ```nabi
    /// assert((try optimize::bisect(|x: f64| -> f64 { x - 1.0 }, 0.0, 3.0)).success());
    /// ```
    pub fn success(self) -> bool { self.status == Status::Converged }
}

impl Display for Root {
    fn fmt(self, ref f: Formatter) throws (FmtError) {
        try f.write_str(f"{self.status}: x = {self.x}, f(x) = {self.fx} after {self.iterations} iterations ({self.nfev} evaluations)")
    }
}

fn check(xtol: f64, rtol: f64, max_iter: usize) throws (OptimizeError) {
    if !(xtol >= 0.0) { throw option(f"xtol = {xtol}; it must be >= 0"); }
    if !(rtol >= 4.0 * EPS) { throw option(f"rtol = {rtol}; it must be at least 4 eps = 8.9e-16"); }
    if max_iter == 0 { throw option("max_iter is 0; allow at least 1 iteration"); }
}

/// Evaluates both ends; throws unless they bracket a sign change. A
/// zero at an end is returned as `Some`.
fn ends(f: fn(f64) -> f64, a: f64, b: f64) throws (OptimizeError) -> (f64, f64, Root?) {
    if !a.is_finite() || !b.is_finite() { throw OptimizeError::NotFinite { what: "an end of the bracket" }; }
    let fa = f(a);
    let fb = f(b);
    if fa == 0.0 { return (fa, fb, Root { x: a, fx: 0.0, iterations: 0, nfev: 2, status: Status::Converged }); }
    if fb == 0.0 { return (fa, fb, Root { x: b, fx: 0.0, iterations: 0, nfev: 2, status: Status::Converged }); }
    if !fa.is_finite() || !fb.is_finite() { throw OptimizeError::NotFinite { what: f"f at an end of [{a}, {b}]" }; }
    if (fa > 0.0) == (fb > 0.0) { throw OptimizeError::NoSignChange { a, b, fa, fb }; }
    (fa, fb, none)
}

/// Bisection on a bracket `[a, b]` with `f(a) f(b) < 0`: halves it
/// until it is below `xtol + rtol |x|`. One evaluation per iteration,
/// one bit per iteration; never fails.
///
/// ```nabi
/// let r = try optimize::bisect(|x: f64| -> f64 { x.cos() - x }, 0.0, 1.0);
/// assert((r.x - 0.7390851332151607).abs() < 1e-11);
/// ```
pub fn bisect(f: fn(f64) -> f64, a: f64, b: f64, xtol: f64 = 2e-12, rtol: f64 = 8.881784197001252e-16, max_iter: usize = 100) throws (OptimizeError) -> Root {
    try check(xtol, rtol, max_iter);
    let (fa, fb, hit) = try ends(f, a, b);
    if hit is Root { return hit; }
    _ = fb;
    let (lo, hi) = (a, b);
    let flo = fa;
    for k in 1..=max_iter {
        let m = lo + 0.5 * (hi - lo);
        let fm = f(m);
        if !fm.is_finite() { return Root { x: m, fx: fm, iterations: k, nfev: k + 2, status: Status::NotFinite }; }
        if fm == 0.0 || (hi - lo).abs() * 0.5 <= xtol + rtol * m.abs() {
            return Root { x: m, fx: fm, iterations: k, nfev: k + 2, status: Status::Converged };
        }
        if (fm > 0.0) == (flo > 0.0) {
            lo = m;
            flo = fm;
        } else {
            hi = m;
        }
    }
    let m = lo + 0.5 * (hi - lo);
    Root { x: m, fx: f(m), iterations: max_iter, nfev: max_iter + 3, status: Status::MaxIterations }
}

/// Ridders' method on a bracket: an exponential fit through the ends
/// and the midpoint; quadratic convergence, two evaluations per
/// iteration, always inside the bracket.
///
/// ```nabi
/// let r = try optimize::ridder(|x: f64| -> f64 { x.exp() - 2.0 }, 0.0, 2.0);
/// assert((r.x - 2.0f64.ln()).abs() < 1e-12);
/// ```
pub fn ridder(f: fn(f64) -> f64, a: f64, b: f64, xtol: f64 = 2e-12, rtol: f64 = 8.881784197001252e-16, max_iter: usize = 100) throws (OptimizeError) -> Root {
    try check(xtol, rtol, max_iter);
    let (fa, fb, hit) = try ends(f, a, b);
    if hit is Root { return hit; }
    let (lo, hi, flo, fhi) = (a, b, fa, fb);
    let nfev = 2;
    let x = lo;
    let fx = flo;
    for k in 1..=max_iter {
        let m = 0.5 * (lo + hi);
        let fm = f(m);
        nfev += 1;
        let s = (fm * fm - flo * fhi).sqrt();
        if s == 0.0 || !s.is_finite() { return Root { x: m, fx: fm, iterations: k, nfev, status: if fm == 0.0 { Status::Converged } else { Status::NotFinite } }; }
        let sign = if flo < fhi { -1.0 } else { 1.0 };
        let xn = m + (m - lo) * sign * fm / s;
        let fxn = f(xn);
        nfev += 1;
        let conv = (xn - x).abs() <= xtol + rtol * xn.abs();
        x = xn;
        fx = fxn;
        if fxn == 0.0 || (k > 1 && conv) { return Root { x, fx, iterations: k, nfev, status: Status::Converged }; }
        if (fm > 0.0) != (fxn > 0.0) {
            lo = m;
            flo = fm;
            hi = xn;
            fhi = fxn;
        } else if (flo > 0.0) != (fxn > 0.0) {
            hi = xn;
            fhi = fxn;
        } else {
            lo = xn;
            flo = fxn;
        }
        if (hi - lo).abs() <= xtol + rtol * x.abs() { return Root { x, fx, iterations: k, nfev, status: Status::Converged }; }
    }
    Root { x, fx, iterations: max_iter, nfev, status: Status::MaxIterations }
}

/// Brent's method on a bracket: inverse quadratic interpolation and
/// secant steps, falling back to bisection, so it is as safe as
/// `bisect` and superlinear on smooth functions. The usual choice.
///
/// ```nabi
/// let r = try optimize::brentq(|x: f64| -> f64 { x ** 3 - 2.0 * x - 5.0 }, 2.0, 3.0);
/// assert((r.x - 2.0945514815423265).abs() < 1e-12);
/// ```
pub fn brentq(f: fn(f64) -> f64, a: f64, b: f64, xtol: f64 = 2e-12, rtol: f64 = 8.881784197001252e-16, max_iter: usize = 100) throws (OptimizeError) -> Root {
    try check(xtol, rtol, max_iter);
    let (fa, fb, hit) = try ends(f, a, b);
    if hit is Root { return hit; }
    // b is the best estimate, a the previous one, c the contrapoint.
    let (xpre, xcur, fpre, fcur) = (a, b, fa, fb);
    let (xblk, fblk, spre, scur) = (0.0, 0.0, 0.0, 0.0);
    let nfev = 2;
    for k in 1..=max_iter {
        if fpre != 0.0 && fcur != 0.0 && (fpre > 0.0) != (fcur > 0.0) {
            xblk = xpre;
            fblk = fpre;
            spre = xcur - xpre;
            scur = spre;
        }
        if fblk.abs() < fcur.abs() {
            xpre = xcur;
            xcur = xblk;
            xblk = xpre;
            fpre = fcur;
            fcur = fblk;
            fblk = fpre;
        }
        let delta = (xtol + rtol * xcur.abs()) / 2.0;
        let sbis = (xblk - xcur) / 2.0;
        if fcur == 0.0 || sbis.abs() < delta { return Root { x: xcur, fx: fcur, iterations: k - 1, nfev, status: Status::Converged }; }
        if spre.abs() > delta && fcur.abs() < fpre.abs() {
            let stry = if xpre == xblk {
                // secant
                -fcur * (xcur - xpre) / (fcur - fpre)
            } else {
                // inverse quadratic
                let dpre = (fpre - fcur) / (xpre - xcur);
                let dblk = (fblk - fcur) / (xblk - xcur);
                -fcur * (fblk * dblk - fpre * dpre) / (dblk * dpre * (fblk - fpre))
            };
            if 2.0 * stry.abs() < spre.abs().min(3.0 * sbis.abs() - delta) {
                spre = scur;
                scur = stry;
            } else {
                spre = sbis;
                scur = sbis;
            }
        } else {
            spre = sbis;
            scur = sbis;
        }
        xpre = xcur;
        fpre = fcur;
        if scur.abs() > delta { xcur += scur; } else { xcur += if sbis > 0.0 { delta } else { -delta }; }
        fcur = f(xcur);
        nfev += 1;
        if !fcur.is_finite() { return Root { x: xcur, fx: fcur, iterations: k, nfev, status: Status::NotFinite }; }
    }
    Root { x: xcur, fx: fcur, iterations: max_iter, nfev, status: Status::MaxIterations }
}

/// The bracket state of TOMS 748.
struct Br {
    a: f64; b: f64; fa: f64; fb: f64;
}

/// Puts `c` into the bracket in place of the end with the sign of
/// `f(c)`; returns the end it replaced.
fn replace(ref br: Br, c: f64, fc: f64) -> (f64, f64) {
    if (fc > 0.0) == (br.fa > 0.0) {
        let old = (br.a, br.fa);
        br.a = c;
        br.fa = fc;
        old
    } else {
        let old = (br.b, br.fb);
        br.b = c;
        br.fb = fc;
        old
    }
}

/// The zero of the inverse cubic through four points (Aitken-Neville).
fn inverse_cubic(a: f64, b: f64, c: f64, d: f64, fa: f64, fb: f64, fc: f64, fd: f64) -> f64 {
    let q11 = (c - d) * fc / (fd - fc);
    let q21 = (b - c) * fb / (fc - fb);
    let q31 = (a - b) * fa / (fb - fa);
    let d21 = (b - c) * fc / (fc - fb);
    let d31 = (a - b) * fb / (fb - fa);
    let q22 = (d21 - q11) * fb / (fd - fb);
    let q32 = (d31 - q21) * fa / (fc - fa);
    let d32 = (d31 - q21) * fc / (fc - fa);
    let q33 = (d32 - q22) * fa / (fd - fa);
    a + q31 + q32 + q33
}

/// `k` Newton steps on the quadratic through the ends and `d`, kept
/// inside the bracket.
fn newton_quadratic(br: Br, d: f64, fd: f64, k: usize) -> f64 {
    let (a, b, fa, fb) = (br.a, br.b, br.fa, br.fb);
    let bb = (fb - fa) / (b - a);
    let fbd = (fd - fb) / (d - b);
    let aa = (fbd - bb) / (d - a);
    let p = |x: f64| -> f64 { (aa * (x - b) + bb) * (x - a) + fa };
    if aa == 0.0 { return a - fa / bb; }
    let r = if (aa > 0.0) == (fa > 0.0) { a } else { b };
    for _ in 0..k {
        let r1 = r - p(r) / (bb + aa * (2.0 * r - a - b));
        if !(a < r1 && r1 < b) {
            if a < r && r < b { return r; }
            return 0.5 * (a + b);
        }
        r = r1;
    }
    r
}

fn distinct(xs: List<f64>, tol: f64) -> bool {
    for i in 0..xs.len() {
        for j in 0..i {
            if (xs[i] - xs[j]).abs() <= tol { return false; }
        }
    }
    true
}

/// TOMS 748 (Alefeld, Potra and Shi) on a bracket: inverse cubic and
/// Newton-quadratic steps with a double-length secant step and a
/// bisection guard, so the bracket shrinks by at least half every
/// iteration. Asymptotic efficiency index 1.65, usually fewer
/// evaluations than `brentq`.
///
/// ```nabi
/// let r = try optimize::toms748(|x: f64| -> f64 { x ** 3 - 2.0 * x - 5.0 }, 2.0, 3.0);
/// assert((r.x - 2.0945514815423265).abs() < 1e-12);
/// ```
pub fn toms748(f: fn(f64) -> f64, a: f64, b: f64, xtol: f64 = 2e-12, rtol: f64 = 8.881784197001252e-16, max_iter: usize = 100) throws (OptimizeError) -> Root {
    try check(xtol, rtol, max_iter);
    let (fa, fb, hit) = try ends(f, a, b);
    if hit is Root { return hit; }
    let br = if a < b { Br { a, b, fa, fb } } else { Br { a: b, b: a, fa: fb, fb: fa } };
    let nfev = 2;
    let best = |s: Br| -> (f64, f64) { if s.fa.abs() < s.fb.abs() { (s.a, s.fa) } else { (s.b, s.fb) } };
    let done = |s: Br, k: usize, n: usize, st: Status| -> Root {
        let (x, fx) = if s.fa.abs() < s.fb.abs() { (s.a, s.fa) } else { (s.b, s.fb) };
        Root { x, fx, iterations: k, nfev: n, status: st }
    };
    // First step: secant.
    let c = br.a - br.fa * (br.b - br.a) / (br.fb - br.fa);
    if !(br.a < c && c < br.b) { c = 0.5 * (br.a + br.b); }
    let fc = f(c);
    nfev += 1;
    if fc == 0.0 { return Root { x: c, fx: 0.0, iterations: 1, nfev, status: Status::Converged }; }
    if !fc.is_finite() { return Root { x: c, fx: fc, iterations: 1, nfev, status: Status::NotFinite }; }
    let (d, fd) = replace(ref br, c, fc);
    let (e, fe) = (f64::NAN, f64::NAN);
    for k in 1..=max_iter {
        let (xb, _) = best(br);
        if br.b - br.a <= 2.0 * (xtol + rtol * xb.abs()) { return done(br, k, nfev, Status::Converged); }
        let width = br.b - br.a;
        for steps in 2..4 {
            let c = f64::NAN;
            if e == e && distinct([br.fa, br.fb, fd, fe], 32.0 * EPS) {
                let c0 = inverse_cubic(br.a, br.b, d, e, br.fa, br.fb, fd, fe);
                if br.a < c0 && c0 < br.b { c = c0; }
            }
            if !(br.a < c && c < br.b) { c = newton_quadratic(br, d, fd, steps); }
            let fc = f(c);
            nfev += 1;
            if fc == 0.0 { return Root { x: c, fx: 0.0, iterations: k, nfev, status: Status::Converged }; }
            if !fc.is_finite() { return Root { x: c, fx: fc, iterations: k, nfev, status: Status::NotFinite }; }
            e = d;
            fe = fd;
            let (dd, fdd) = replace(ref br, c, fc);
            d = dd;
            fd = fdd;
        }
        // Double-length secant step from the better end.
        let (u, fu) = best(br);
        let c = u - 2.0 * fu * (br.b - br.a) / (br.fb - br.fa);
        if !(br.a < c && c < br.b) || (c - u).abs() > 0.5 * (br.b - br.a) { c = 0.5 * (br.a + br.b); }
        let fc = f(c);
        nfev += 1;
        if fc == 0.0 { return Root { x: c, fx: 0.0, iterations: k, nfev, status: Status::Converged }; }
        if !fc.is_finite() { return Root { x: c, fx: fc, iterations: k, nfev, status: Status::NotFinite }; }
        e = d;
        fe = fd;
        let (z, fz) = replace(ref br, c, fc);
        if br.b - br.a > 0.5 * width {
            // Not enough progress: bisect.
            e = z;
            fe = fz;
            let m = 0.5 * (br.a + br.b);
            let fm = f(m);
            nfev += 1;
            if fm == 0.0 { return Root { x: m, fx: 0.0, iterations: k, nfev, status: Status::Converged }; }
            let (dd, fdd) = replace(ref br, m, fm);
            d = dd;
            fd = fdd;
        } else {
            d = z;
            fd = fz;
        }
    }
    done(br, max_iter, nfev, Status::MaxIterations)
}

/// Widens `[a, b]` until `f` changes sign over it: each step moves the
/// end that the secant through both ends points past, to where the
/// secant crosses zero plus half the width, but by at least one width
/// and at most two. Throws after `max_iter` steps.
///
/// ```nabi
/// let (a, b) = try optimize::bracket_root(|x: f64| -> f64 { x - 100.0 }, 0.0, 1.0);
/// assert(a <= 100.0 && 100.0 <= b);
/// ```
pub fn bracket_root(f: fn(f64) -> f64, a: f64, b: f64, max_iter: usize = 60) throws (OptimizeError) -> (f64, f64) {
    if a == b { throw option("a == b; pass two different points"); }
    if !a.is_finite() || !b.is_finite() { throw OptimizeError::NotFinite { what: "a start point" }; }
    let (lo, hi) = if a < b { (a, b) } else { (b, a) };
    let flo = f(lo);
    let fhi = f(hi);
    for _ in 0..max_iter {
        if (flo > 0.0) != (fhi > 0.0) || flo == 0.0 || fhi == 0.0 { return (lo, hi); }
        if !(lo.is_finite() && hi.is_finite() && flo.is_finite() && fhi.is_finite()) { break; }
        let w = hi - lo;
        // With both values of one sign the secant's zero lies outside
        // [lo, hi], beyond the end with the smaller |f|; its distance from
        // that end is w |f_near| / |f_hi - f_lo|.
        let near = if flo.abs() < fhi.abs() { flo } else { fhi };
        let far = if flo.abs() < fhi.abs() { fhi } else { flo };
        let reach = if near == far { 2.0 * w } else { w * (near / (far - near)).abs() + 0.5 * w };
        let step = reach.clamp(w, 2.0 * w);
        if flo.abs() < fhi.abs() {
            lo -= step;
            flo = f(lo);
        } else {
            hi += step;
            fhi = f(hi);
        }
    }
    throw OptimizeError::NoSignChange { a: lo, b: hi, fa: flo, fb: fhi };
}

/// Newton's method from `x0` with the derivative `df`: quadratic
/// convergence near a simple root. Stops when a step is below
/// `tol`; a zero derivative gives `Stalled`.
///
/// ```nabi
/// let r = try optimize::newton(|x: f64| -> f64 { x * x - 2.0 }, |x: f64| -> f64 { 2.0 * x }, 1.0);
/// assert((r.x - 2.0f64.sqrt()).abs() < 1e-14 && r.iterations < 8);
/// ```
pub fn newton(f: fn(f64) -> f64, df: fn(f64) -> f64, x0: f64, tol: f64 = 1.48e-8, rtol: f64 = 0.0, max_iter: usize = 50) throws (OptimizeError) -> Root {
    try open_check(x0, tol, rtol, max_iter);
    let x = x0;
    for k in 1..=max_iter {
        let fx = f(x);
        if fx == 0.0 { return Root { x, fx, iterations: k - 1, nfev: 2 * k - 1, status: Status::Converged }; }
        let d = df(x);
        if !fx.is_finite() || !d.is_finite() { return Root { x, fx, iterations: k, nfev: 2 * k, status: Status::NotFinite }; }
        if d == 0.0 { return Root { x, fx, iterations: k, nfev: 2 * k, status: Status::Stalled }; }
        let xn = x - fx / d;
        if (xn - x).abs() <= tol + rtol * xn.abs() { return Root { x: xn, fx: f(xn), iterations: k, nfev: 2 * k + 1, status: Status::Converged }; }
        x = xn;
    }
    Root { x, fx: f(x), iterations: max_iter, nfev: 2 * max_iter + 1, status: Status::MaxIterations }
}

/// Newton's method with the derivative by forward-mode AD: write `f`
/// over `Dual`, one evaluation per iteration gives `f` and `f'`.
///
/// ```nabi
/// use optimize::Dual;
///
/// let r = try optimize::newton_ad(|x: Dual| -> Dual { x.cos() - x }, 1.0);
/// assert((r.x - 0.7390851332151607).abs() < 1e-14);
/// ```
pub fn newton_ad(f: fn(Dual) -> Dual, x0: f64, tol: f64 = 1.48e-8, rtol: f64 = 0.0, max_iter: usize = 50) throws (OptimizeError) -> Root {
    try open_check(x0, tol, rtol, max_iter);
    let x = x0;
    for k in 1..=max_iter {
        let y = f(Dual::var(x));
        if y.re == 0.0 { return Root { x, fx: 0.0, iterations: k - 1, nfev: k, status: Status::Converged }; }
        if !y.is_finite() { return Root { x, fx: y.re, iterations: k, nfev: k, status: Status::NotFinite }; }
        if y.du == 0.0 { return Root { x, fx: y.re, iterations: k, nfev: k, status: Status::Stalled }; }
        let xn = x - y.re / y.du;
        if (xn - x).abs() <= tol + rtol * xn.abs() { return Root { x: xn, fx: f(Dual::constant(xn)).re, iterations: k, nfev: k + 1, status: Status::Converged }; }
        x = xn;
    }
    Root { x, fx: f(Dual::constant(x)).re, iterations: max_iter, nfev: max_iter + 1, status: Status::MaxIterations }
}

/// Halley's method with the first and second derivatives: cubic
/// convergence near a simple root.
///
/// ```nabi
/// let f = |x: f64| -> f64 { x ** 3 - 2.0 };
/// let r = try optimize::halley(f, |x: f64| -> f64 { 3.0 * x * x }, |x: f64| -> f64 { 6.0 * x }, 1.0);
/// assert((r.x - 2.0f64.cbrt()).abs() < 1e-14 && r.iterations <= 5);
/// ```
pub fn halley(f: fn(f64) -> f64, df: fn(f64) -> f64, d2f: fn(f64) -> f64, x0: f64, tol: f64 = 1.48e-8, rtol: f64 = 0.0, max_iter: usize = 50) throws (OptimizeError) -> Root {
    try open_check(x0, tol, rtol, max_iter);
    let x = x0;
    for k in 1..=max_iter {
        let fx = f(x);
        if fx == 0.0 { return Root { x, fx, iterations: k - 1, nfev: 3 * k - 2, status: Status::Converged }; }
        let d1 = df(x);
        let d2 = d2f(x);
        if !fx.is_finite() || !d1.is_finite() || !d2.is_finite() { return Root { x, fx, iterations: k, nfev: 3 * k, status: Status::NotFinite }; }
        if d1 == 0.0 { return Root { x, fx, iterations: k, nfev: 3 * k, status: Status::Stalled }; }
        let newton = fx / d1;
        let den = 1.0 - 0.5 * newton * d2 / d1;
        // Fall back to the Newton step when the correction is wild.
        let step = if den.abs() < 0.5 || !den.is_finite() { newton } else { newton / den };
        let xn = x - step;
        if (xn - x).abs() <= tol + rtol * xn.abs() { return Root { x: xn, fx: f(xn), iterations: k, nfev: 3 * k + 1, status: Status::Converged }; }
        x = xn;
    }
    Root { x, fx: f(x), iterations: max_iter, nfev: 3 * max_iter + 1, status: Status::MaxIterations }
}

/// The secant method from `x0` and `x1`: no derivative, order 1.618
/// near a simple root.
///
/// ```nabi
/// let r = try optimize::secant(|x: f64| -> f64 { x.exp() - 3.0 }, 0.0, 1.0);
/// assert((r.x - 3.0f64.ln()).abs() < 1e-12);
/// ```
pub fn secant(f: fn(f64) -> f64, x0: f64, x1: f64, tol: f64 = 1.48e-8, rtol: f64 = 0.0, max_iter: usize = 50) throws (OptimizeError) -> Root {
    try open_check(x0, tol, rtol, max_iter);
    if !x1.is_finite() { throw OptimizeError::NotFinite { what: "x1" }; }
    if x0 == x1 { throw option("x0 == x1; pass two different starts"); }
    let (p0, p1) = (x0, x1);
    let q0 = f(p0);
    let q1 = f(p1);
    if q1.abs() > q0.abs() {
        let t = p0;
        p0 = p1;
        p1 = t;
        let u = q0;
        q0 = q1;
        q1 = u;
    }
    for k in 1..=max_iter {
        if q1 == 0.0 { return Root { x: p1, fx: 0.0, iterations: k - 1, nfev: k + 1, status: Status::Converged }; }
        if !q1.is_finite() { return Root { x: p1, fx: q1, iterations: k, nfev: k + 1, status: Status::NotFinite }; }
        if q1 == q0 { return Root { x: p1, fx: q1, iterations: k, nfev: k + 1, status: Status::Stalled }; }
        let p = p1 - q1 * (p1 - p0) / (q1 - q0);
        if (p - p1).abs() <= tol + rtol * p.abs() { return Root { x: p, fx: f(p), iterations: k, nfev: k + 2, status: Status::Converged }; }
        p0 = p1;
        q0 = q1;
        p1 = p;
        q1 = f(p1);
    }
    Root { x: p1, fx: q1, iterations: max_iter, nfev: max_iter + 2, status: Status::MaxIterations }
}

fn open_check(x0: f64, tol: f64, rtol: f64, max_iter: usize) throws (OptimizeError) {
    if !x0.is_finite() { throw OptimizeError::NotFinite { what: "x0" }; }
    if !(tol >= 0.0) || !(rtol >= 0.0) { throw option(f"tol = {tol}, rtol = {rtol}; both must be >= 0"); }
    if max_iter == 0 { throw option("max_iter is 0; allow at least 1 iteration"); }
}
