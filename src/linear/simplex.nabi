// Dense two-phase tableau simplex on the standard form. Phase 1
// minimizes the sum of the artificial variables from the slack /
// artificial basis; phase 2 the objective. Pricing is Dantzig's (most
// negative reduced cost) until 50 degenerate pivots in a row, then
// Bland's rule, which cannot cycle.

use pkg::linear::Standard;
use pkg::result::Status;
use core::array::{Array, Vector};

struct Tableau {
    rows: List<Vector<f64>>;
    obj: Vector<f64>;
    basis: List<usize>;
    width: usize;
}

impl Tableau {
    fn pivot(ref self, r: usize, j: usize) {
        let row = self.rows[r];
        let p = row[j];
        row ./= p;
        for i in 0..self.rows.len() {
            if i == r { continue; }
            let t = self.rows[i];
            let v = t[j];
            if v != 0.0 {
                t .-= v .* row;
                t[j] = 0.0;
            }
        }
        let v = self.obj[j];
        if v != 0.0 {
            self.obj .-= v .* row;
            self.obj[j] = 0.0;
        }
        self.basis[r] = j;
    }

    /// Runs pivots over the columns `< ncols` that `allowed` admits.
    /// Returns the status and adds to `count`.
    fn run(ref self, ncols: usize, banned: List<bool>, tol: f64, max_iter: usize, ref count: usize) -> Status {
        let rhs = self.width - 1;
        let degenerate = 0;
        loop {
            if count >= max_iter { return Status::MaxIterations; }
            let bland = degenerate >= 50;
            let j = ncols;
            let best = -tol;
            for c in 0..ncols {
                if banned[c] { continue; }
                let d = self.obj[c];
                if d < best {
                    j = c;
                    if bland { break; }
                    best = d;
                }
            }
            if j == ncols { return Status::Converged; }
            let r = self.rows.len();
            let ratio = f64::INFINITY;
            for i in 0..self.rows.len() {
                let a = self.rows[i][j];
                if a > tol {
                    let q = self.rows[i][rhs] / a;
                    if q < ratio || (q == ratio && r < self.rows.len() && self.basis[i] < self.basis[r]) {
                        ratio = q;
                        r = i;
                    }
                }
            }
            if r == self.rows.len() { return Status::Unbounded; }
            if ratio <= tol { degenerate += 1; } else { degenerate = 0; }
            self.pivot(r, j);
            count += 1;
        }
    }
}

pub(pkg) fn solve(s: Standard, max_iter: usize, tol: f64) -> (Vector<f64>, Status, usize) {
    let m = s.a.shape()[0];
    let nt = s.a.shape()[1];
    let limit = if max_iter == 0 { 50 * (m + nt).max(10) } else { max_iter };
    // Artificial columns for the rows without a usable slack.
    let art: List<usize> = [];
    let flip: List<bool> = [];
    for i in 0..m {
        let neg = s.b[i] < 0.0;
        flip.push(neg);
        let has_slack = i < s.a.shape()[1] - s.slack0 && !neg;
        if !has_slack { art.push(i); }
    }
    let na = art.len();
    let width = nt + na + 1;
    let rows: List<Vector<f64>> = List::with_capacity(m);
    let basis: List<usize> = List::with_capacity(m);
    for i in 0..m {
        let r: Vector<f64> = Array::zeros([width]);
        let sg = if flip[i] { -1.0 } else { 1.0 };
        r[0:nt] .= sg .* s.a[i];
        r[width - 1] = sg * s.b[i];
        rows.push(r);
        basis.push(s.slack0 + i);
    }
    for k in 0..na {
        let i = art[k];
        rows[i][nt + k] = 1.0;
        basis[i] = nt + k;
    }
    let obj: Vector<f64> = Array::zeros([width]);
    for k in 0..na { obj .-= rows[art[k]]; }
    for k in 0..na { obj[nt + k] = 0.0; }
    let t = Tableau { rows, obj, basis, width };
    let count = 0;
    let banned: List<bool> = List::from_fn(nt + na, |_| false);
    if na > 0 {
        let st = t.run(nt + na, banned, tol, limit, ref count);
        if st == Status::MaxIterations { return (point(t, nt), st, count); }
        let scale = 1.0;
        for v in s.b { scale = scale.max(v.abs()); }
        if -t.obj[width - 1] > tol * scale * (m as f64) { return (point(t, nt), Status::Infeasible, count); }
        // Pivot the artificials left in the basis (at zero) out.
        for i in 0..m {
            if t.basis[i] < nt { continue; }
            let row = t.rows[i];
            let j = nt;
            let big = tol;
            for c in 0..nt {
                if row[c].abs() > big {
                    big = row[c].abs();
                    j = c;
                }
            }
            if j < nt { t.pivot(i, j); }
        }
        for k in 0..na { banned[nt + k] = true; }
    }
    // Phase 2: the reduced costs of c.
    let obj: Vector<f64> = Array::zeros([width]);
    obj[0:nt] .= s.c;
    for i in 0..m {
        let bj = t.basis[i];
        if bj < nt && s.c[bj] != 0.0 { obj .-= s.c[bj] .* t.rows[i]; }
    }
    t.obj = obj;
    let st = t.run(nt + na, banned, tol, limit, ref count);
    (point(t, nt), st, count)
}

fn point(t: Tableau, nt: usize) -> Vector<f64> {
    let z: Vector<f64> = Array::zeros([nt]);
    for i in 0..t.rows.len() {
        let b = t.basis[i];
        if b < nt { z[b] = t.rows[i][t.width - 1].max(0.0); }
    }
    z
}
