// Rosenbrock with its exact gradient from (-1.2, 1, -1.2, 1, ...),
// solved to the default tolerances. One item is one solve.

use core::array::{Array, Vector};
use core::bench::Bench;
use core::hint::black_box;

fn start(n: usize) -> Vector<f64> { Array::from_fn([n], |i: [usize; 1]| -> f64 { if i[0] % 2 == 0 { -1.2 } else { 1.0 } }) }

fn bfgs(b: Bench, n: usize) {
    let x0 = start(n);
    b.iter(|| try! pkg::bfgs(pkg::problems::rosenbrock(), black_box(x0)));
}

fn lbfgs(b: Bench, n: usize) {
    let x0 = start(n);
    b.iter(|| try! pkg::lbfgs(pkg::problems::rosenbrock(), black_box(x0)));
}

#[bench]
fn bfgs_rosen_2(b: Bench) { bfgs(b, 2); }

#[bench]
fn bfgs_rosen_100(b: Bench) { bfgs(b, 100); }

#[bench]
fn bfgs_rosen_1000(b: Bench) { bfgs(b, 1000); }

#[bench]
fn lbfgs_rosen_2(b: Bench) { lbfgs(b, 2); }

#[bench]
fn lbfgs_rosen_100(b: Bench) { lbfgs(b, 100); }

#[bench]
fn lbfgs_rosen_1000(b: Bench) { lbfgs(b, 1000); }

// The gradient by forward-mode AD (n passes), for comparison.
#[bench]
fn lbfgs_rosen_100_dual(b: Bench) {
    let x0 = start(100);
    b.iter(|| try! pkg::lbfgs(pkg::problems::rosen::<pkg::Dual>, black_box(x0)));
}

// The gradient by reverse-mode AD (one sweep), for comparison.
#[bench]
fn lbfgs_rosen_100_var(b: Bench) {
    let x0 = start(100);
    b.iter(|| try! pkg::lbfgs(pkg::problems::rosen::<pkg::Var>, black_box(x0)));
}

#[bench]
fn lbfgs_rosen_1000_var(b: Bench) {
    let x0 = start(1000);
    b.iter(|| try! pkg::lbfgs(pkg::problems::rosen::<pkg::Var>, black_box(x0)));
}
